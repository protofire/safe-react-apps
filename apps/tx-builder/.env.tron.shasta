# Transaction Builder -- build configuration for Safe{Wallet} Tron (staging).
#
# Target deployment: UI      https://tron-app.stage.safe.protofire.io
#                    gateway https://gateway-tron.stage.safe.protofire.io
#                    chain   Tron Shasta Testnet, 2494104990 (the only chain served)
#
# Build with:  yarn workspace tx-builder build:tron
# Verify with: node scripts/verify_safe_app_deployment.mjs <deployed-url> \
#                --expect-gateway https://gateway-tron.stage.safe.protofire.io
#
# See apps/tx-builder/TRON_DEPLOYMENT.md for the full runbook.

HTTPS=false

# --- The one setting that actually matters -----------------------------------
# Consumed by src/lib/getAbi.ts for the gateway ABI lookup
# (`/v1/chains/{chainId}/contracts/{address}`) and for the chain-info fetch
# (`/v1/chains/{chainId}`) that the scan-API and Tron-node paths share -- the
# Tron path reads the node endpoint out of that chain config, so ABI auto-lookup
# depends on this URL too.
#
# It MUST be this deployment's own gateway. Pointing it at Safe's public gateway
# or at Protofire's multi-chain gateway registry silently breaks all ABI
# lookup: neither serves chain 2494104990 (verified 2026-08-03 --
# gateway-registry.safe.protofire.io/v1/chains/2494104990 -> 404).
REACT_APP_GATEWAY_BASE_URL=https://gateway-tron.stage.safe.protofire.io

# --- Intentionally unset -----------------------------------------------------
# Tenderly simulation is unconditionally disabled on this branch:
# src/lib/simulation/simulation.ts:18-21 hardcodes `isSimulationSupported` to
# return false, so the "Simulate" button (src/pages/ReviewAndConfirm.tsx:118)
# never renders. Shasta's chain config does not ship the TX_SIMULATION feature
# either. Leave these blank; do not attempt a Tron substitute.
REACT_APP_TENDERLY_SIMULATE_ENDPOINT_URL=
REACT_APP_TENDERLY_PROJECT_NAME=
REACT_APP_TENDERLY_ORG_NAME=

# Explorer API keys feed the scan-API ABI path in src/lib/getAbi.ts, which expects
# an Etherscan-V2-, Blockscout- or Subscan-shaped response. Tronscan's contract API
# matches none of those shapes, so that path cannot work on Tron -- and it is not
# needed: ABI auto-lookup goes through `getAbiFromTronNode`, which reads the ABI
# Tron stores on chain via the node's `wallet/getcontract` (works for unverified
# contracts, needs no key, and derives its endpoint from the gateway's own chain
# config). See apps/tx-builder/TRON_DEPLOYMENT.md §7c. Leave these blank.
REACT_APP_ETHERSCAN_API_KEY=
REACT_APP_SOCIALSCAN_API_KEY=
REACT_APP_CRONOS_ZK_EVM_API_KEY=
REACT_APP_CRONOS_API_KEY=
REACT_APP_CRONOS_TESTNET_API_KEY=
REACT_APP_SUBSCAN_API_KEY=

# Only used by the hardhat test-contract tasks (`yarn contract:deploy-all`),
# never by the app build.
INFURA_KEY=
PRIVATE_KEY=
ETHERSCAN_API_KEY=
